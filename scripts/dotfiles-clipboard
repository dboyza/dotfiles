#!/usr/bin/env bash

set -euo pipefail

operation=${1:-}
case "$operation" in
  copy | paste | --check) ;;
  paste-to-tmux) [[ -n ${2:-} ]] || exit 2 ;;
  *)
    printf 'Usage: dotfiles-clipboard {copy|paste|--check|paste-to-tmux PANE}\n' >&2
    exit 2
    ;;
esac

available() { command -v "$1" >/dev/null 2>&1; }

# Select a complete provider pair once, with Windows taking priority in WSLg.
if { [[ -n ${WSL_DISTRO_NAME:-}${WSL_INTEROP:-} ]] || [[ $(uname -r) == *[Mm]icrosoft* ]]; } && available win-copy && available win-paste; then
  copy=(win-copy)
  paste=(win-paste)
elif [[ $(uname -s) == Darwin ]] && available pbcopy && available pbpaste; then
  copy=(pbcopy)
  paste=(pbpaste)
elif [[ -n ${WAYLAND_DISPLAY:-} ]] && available wl-copy && available wl-paste; then
  copy=(wl-copy)
  paste=(wl-paste --no-newline)
elif [[ -n ${DISPLAY:-} ]] && available xclip; then
  copy=(xclip -selection clipboard)
  paste=(xclip -selection clipboard -out)
elif [[ -n ${DISPLAY:-} ]] && available xsel; then
  copy=(xsel --clipboard --input)
  paste=(xsel --clipboard --output)
elif [[ -n ${TMUX:-} ]] && available tmux; then
  copy=(tmux load-buffer -)
  paste=(tmux save-buffer -)
else
  [[ $operation == --check ]] || printf 'dotfiles-clipboard: no clipboard provider available\n' >&2
  exit 1
fi

case "$operation" in
  copy) exec "${copy[@]}" ;;
  paste) exec "${paste[@]}" ;;
  paste-to-tmux)
    if [[ ${paste[0]} != tmux ]]; then
      clipboard_file=$(mktemp "${TMPDIR:-/tmp}/dotfiles-clipboard.XXXXXX")
      trap 'rm -f "$clipboard_file"' EXIT
      "${paste[@]}" >"$clipboard_file"
      # tmux ignores an empty load-buffer input; never paste its previous buffer.
      [[ -s $clipboard_file ]] || exit 0
      tmux load-buffer "$clipboard_file"
    fi
    tmux paste-buffer -t "$2"
    ;;
  --check) exit 0 ;;
esac
